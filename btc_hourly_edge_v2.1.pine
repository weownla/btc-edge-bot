//@version=5
indicator("BTC Hourly Edge v2.1", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
// BTC Hourly Edge Detector v2.1
// ═══════════════════════════════════════════════════════════════════
// Detects momentum building in the last 10 min of each hour.
// Sends JSON alert to your webhook → Telegram bot → your phone.
// You open Kalshi, bet the underdog $250 contract. 10x+ payout.
//
// 7 SCORING FACTORS:
// 1. ROC Momentum     — price moving fast AND accelerating
// 2. RSI Direction    — short RSI confirms the direction
// 3. Candle Direction — 3 of last 4 candles agree
// 4. EMA Displacement — price pulled away from average (real move)
// 5. Momentum Persist — move building over multiple candles
// 6. Strike Proximity — near a Kalshi $250 level
// 7. Volume Spike     — abnormal volume (bonus factor)
// ═══════════════════════════════════════════════════════════════════

// ─── INPUTS ─────────────────────────────────────────────────────
grp_time    = "⏰ Time Window"
window_start = input.int(50, "Signal Window Start (minute)", minval=45, maxval=57, group=grp_time)
window_end   = input.int(57, "Signal Window End (minute)",   minval=50, maxval=59, group=grp_time)

grp_vol     = "📊 Volatility & Momentum"
roc_len      = input.int(5,   "Rate of Change Length",    minval=2,  maxval=10, group=grp_vol)
roc_thresh   = input.float(0.20, "ROC Threshold (%)",     minval=0.05, maxval=1.0, step=0.05, group=grp_vol)
rsi_len      = input.int(7,   "RSI Length (short)",       minval=3,  maxval=14, group=grp_vol)
rsi_upper    = input.float(60, "RSI Bullish Threshold",   minval=55, maxval=75, group=grp_vol)
rsi_lower    = input.float(40, "RSI Bearish Threshold",   minval=25, maxval=45, group=grp_vol)
ema_len      = input.int(20,  "EMA Length",               minval=10, maxval=50, group=grp_vol)
ema_disp_pct = input.float(0.15, "EMA Displacement %",    minval=0.05, maxval=0.5, step=0.05, group=grp_vol)
atr_len      = input.int(14,  "ATR Length",               minval=5,  maxval=50, group=grp_vol)
atr_mult     = input.float(1.5, "ATR Spike Multiplier",   minval=1.1, maxval=3.0, step=0.1, group=grp_vol)

grp_volume  = "🔊 Volume"
vol_len      = input.int(20,  "Volume SMA Length",        minval=10, maxval=50, group=grp_volume)
vol_mult     = input.float(1.8, "Volume Spike Multiplier", minval=1.2, maxval=4.0, step=0.1, group=grp_volume)

grp_struct  = "🏗️ Strike Levels"
use_strike   = input.bool(true, "Boost near Kalshi $250 strikes", group=grp_struct)
strike_dist  = input.int(100, "Strike Proximity (USD)", minval=25, maxval=250, step=25, group=grp_struct, tooltip="Signal boosts when price is within this distance of a $250 strike.")

grp_htf     = "📐 Higher Timeframe"
use_htf      = input.bool(true, "Use 5-min momentum confirmation", group=grp_htf)

grp_filter  = "🎯 Signal Quality"
min_score    = input.int(3, "Min Confluence Score (out of 7)", minval=2, maxval=7, group=grp_filter)

// ─── TIME WINDOW ────────────────────────────────────────────────
min_of_hour  = minute(time)
in_window    = min_of_hour >= window_start and min_of_hour <= window_end

// ─── FACTOR 1: ROC MOMENTUM ────────────────────────────────────
roc_val      = ta.roc(close, roc_len)
roc_prev     = ta.roc(close[1], roc_len)
roc_bull     = roc_val > roc_thresh and roc_val > roc_prev
roc_bear     = roc_val < -roc_thresh and roc_val < roc_prev

// ─── FACTOR 2: RSI DIRECTION ───────────────────────────────────
rsi_val      = ta.rsi(close, rsi_len)
rsi_bull     = rsi_val > rsi_upper
rsi_bear     = rsi_val < rsi_lower

// ─── FACTOR 3: DIRECTIONAL CONSISTENCY ─────────────────────────
bull_candles = (close > open ? 1 : 0) + (close[1] > open[1] ? 1 : 0) + (close[2] > open[2] ? 1 : 0) + (close[3] > open[3] ? 1 : 0)
bear_candles = (close < open ? 1 : 0) + (close[1] < open[1] ? 1 : 0) + (close[2] < open[2] ? 1 : 0) + (close[3] < open[3] ? 1 : 0)
dir_bull     = bull_candles >= 3
dir_bear     = bear_candles >= 3

// ─── FACTOR 4: EMA DISPLACEMENT ────────────────────────────────
ema_val      = ta.ema(close, ema_len)
ema_disp_up  = (close - ema_val) / ema_val * 100 > ema_disp_pct
ema_disp_dn  = (ema_val - close) / ema_val * 100 > ema_disp_pct

// ─── FACTOR 5: MOMENTUM PERSISTENCE ───────────────────────────
persist_bull = close > close[3] and close[1] > close[4]
persist_bear = close < close[3] and close[1] < close[4]

// ─── FACTOR 6: KALSHI STRIKE PROXIMITY ($250) ─────────────────
price_mod_250    = close % 250
near_strike_above = price_mod_250 < strike_dist
near_strike_below = price_mod_250 > (250 - strike_dist)

// ─── FACTOR 7: VOLUME SPIKE ───────────────────────────────────
vol_sma      = ta.sma(volume, vol_len)
vol_spike    = volume > vol_sma * vol_mult

// ─── HIGHER TIMEFRAME (5-min) ──────────────────────────────────
htf_roc      = request.security(syminfo.tickerid, "5", ta.roc(close, 3))
htf_bull     = use_htf ? htf_roc > 0.10 : true
htf_bear     = use_htf ? htf_roc < -0.10 : true

// ─── ATR (dashboard only, not scored) ──────────────────────────
atr_val      = ta.atr(atr_len)
atr_avg      = ta.sma(atr_val, 50)
atr_ratio    = atr_val / atr_avg

// ─── SCORING ────────────────────────────────────────────────────
bull_score = 0
bull_score := bull_score + (roc_bull      ? 1 : 0)
bull_score := bull_score + (rsi_bull      ? 1 : 0)
bull_score := bull_score + (dir_bull      ? 1 : 0)
bull_score := bull_score + (ema_disp_up   ? 1 : 0)
bull_score := bull_score + (persist_bull  ? 1 : 0)
bull_score := bull_score + (use_strike and near_strike_below ? 1 : 0)
bull_score := bull_score + (vol_spike     ? 1 : 0)

bear_score = 0
bear_score := bear_score + (roc_bear      ? 1 : 0)
bear_score := bear_score + (rsi_bear      ? 1 : 0)
bear_score := bear_score + (dir_bear      ? 1 : 0)
bear_score := bear_score + (ema_disp_dn   ? 1 : 0)
bear_score := bear_score + (persist_bear  ? 1 : 0)
bear_score := bear_score + (use_strike and near_strike_above ? 1 : 0)
bear_score := bear_score + (vol_spike     ? 1 : 0)

// ─── SIGNALS ────────────────────────────────────────────────────
bull_raw = in_window and bull_score >= min_score and htf_bull
bear_raw = in_window and bear_score >= min_score and htf_bear

// ─── HOURLY COOLDOWN ────────────────────────────────────────────
var int last_signal_day_hour = -1
current_day_hour = dayofmonth(time) * 100 + hour(time)

bull_fire = bull_raw and current_day_hour != last_signal_day_hour
bear_fire = bear_raw and current_day_hour != last_signal_day_hour

if bull_fire or bear_fire
    last_signal_day_hour := current_day_hour

// ─── ALERTS (JSON → webhook → bot → Telegram) ──────────────────
// Bot only needs: dir, score, price, min. It calculates the target.
if bear_fire
    alert('{"dir":"BEAR","score":' + str.tostring(bear_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + '}', alert.freq_once_per_bar)

if bull_fire
    alert('{"dir":"BULL","score":' + str.tostring(bull_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + '}', alert.freq_once_per_bar)

// ─── CHART VISUALS ──────────────────────────────────────────────
bgcolor(in_window ? color.new(color.yellow, 92) : na, title="Signal Window")
plotshape(bear_fire, "Bear", shape.triangledown, location.abovebar, color.red, size=size.tiny)
plotshape(bull_fire, "Bull", shape.triangleup,   location.belowbar, color.green, size=size.tiny)

if bear_fire
    lbl = "BEAR ▼ [" + str.tostring(bear_score) + "/7]\n"
    lbl := lbl + "ROC:" + (roc_bear ? "✓" : "✗") + " RSI:" + (rsi_bear ? "✓" : "✗") + " DIR:" + (dir_bear ? "✓" : "✗") + "\n"
    lbl := lbl + "EMA:" + (ema_disp_dn ? "✓" : "✗") + " PER:" + (persist_bear ? "✓" : "✗") + " STK:" + (use_strike and near_strike_above ? "✓" : "✗") + "\n"
    lbl := lbl + "VOL:" + (vol_spike ? "✓" : "✗")
    label.new(bar_index, high, lbl, style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)

if bull_fire
    lbl = "BULL ▲ [" + str.tostring(bull_score) + "/7]\n"
    lbl := lbl + "ROC:" + (roc_bull ? "✓" : "✗") + " RSI:" + (rsi_bull ? "✓" : "✗") + " DIR:" + (dir_bull ? "✓" : "✗") + "\n"
    lbl := lbl + "EMA:" + (ema_disp_up ? "✓" : "✗") + " PER:" + (persist_bull ? "✓" : "✗") + " STK:" + (use_strike and near_strike_below ? "✓" : "✗") + "\n"
    lbl := lbl + "VOL:" + (vol_spike ? "✓" : "✗")
    label.new(bar_index, low, lbl, style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.normal)

// ─── DASHBOARD ──────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "BTC Edge v2.1",  text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 60))
    table.cell(dash, 1, 0, "",                text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 60))
    table.cell(dash, 0, 1, "Minute",          text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(min_of_hour) + (in_window ? " ✓ LIVE" : ""), text_color=in_window ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 2, "ROC",             text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(roc_val, "#.###") + "%", text_color=math.abs(roc_val) > roc_thresh ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 3, "RSI(7)",          text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(rsi_val, "#.#"), text_color=(rsi_bull or rsi_bear) ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 4, "EMA Disp",        text_color=color.white,  text_size=size.small)
    disp_val = (close - ema_val) / ema_val * 100
    table.cell(dash, 1, 4, str.tostring(disp_val, "#.###") + "%", text_color=(ema_disp_up or ema_disp_dn) ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 5, "ATR Ratio",       text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(atr_ratio, "#.##") + "x", text_color=atr_ratio > atr_mult ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 6, "Vol Ratio",       text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(volume / vol_sma, "#.##") + "x", text_color=vol_spike ? color.green : color.gray, text_size=size.small)
    nearest_strike = math.round(close / 250) * 250
    table.cell(dash, 0, 7, "Nearest $250",    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 7, "$" + str.tostring(nearest_strike, "#"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 8, "Dist to Strike",  text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 8, "$" + str.tostring(math.abs(close - nearest_strike), "#"), text_color=(near_strike_above or near_strike_below) ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 9, "5m HTF ROC",      text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 9, str.tostring(htf_roc, "#.##") + "%", text_color=(htf_bull or htf_bear) ? color.green : color.gray, text_size=size.small)
