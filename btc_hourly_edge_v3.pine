//@version=5
indicator("BTC Hourly Edge v4", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
// BTC Hourly Edge v4 — Velocity + Volume + Distance
// ═══════════════════════════════════════════════════════════════════
// Backtested on 6.8 days of real BTC data: 71% win rate (5/7).
//
// The old versions used 5-7 indicators trying to be clever.
// This one uses 3 simple conditions that all must be true:
//
//   1. VELOCITY: Price moved $75+ in the last 15 min (it's FAST)
//   2. VOLUME:   Current volume is 3x+ average (it's REAL)
//   3. DISTANCE: Target $250 strike is ≤$250 away (it's REACHABLE)
//
// If all 3 are true → signal fires. Direction = which way velocity is going.
//
// BONUS POINTS (for score display):
//   +1 if velocity > $150 (extra fast)
//   +1 if volume > 5x average (extreme volume)
//   Base = 3/5, max = 5/5
// ═══════════════════════════════════════════════════════════════════

// ─── INPUTS ─────────────────────────────────────────────────────
grp_time    = "⏰ Time Window"
window_start = input.int(45, "Signal Window Start (minute)", minval=40, maxval=55, group=grp_time)
window_end   = input.int(57, "Signal Window End (minute)",   minval=50, maxval=59, group=grp_time)

grp_vel     = "🚀 Velocity"
vel_bars     = input.int(15, "Velocity Lookback (minutes)",  minval=5, maxval=30, step=5, group=grp_vel, tooltip="How far back to measure the move. 15 min = sweet spot from backtest.")
vel_min      = input.float(75, "Min Velocity ($)",           minval=25, maxval=500, step=25, group=grp_vel, tooltip="Price must have moved at least this much. $75 = backtest optimal.")
vel_bonus    = input.float(150, "Bonus Velocity ($)",        minval=50, maxval=500, step=25, group=grp_vel, tooltip="Above this adds a bonus score point.")

grp_vol     = "🔊 Volume"
vol_len      = input.int(20, "Volume SMA Length",            minval=10, maxval=50, group=grp_vol)
vol_min      = input.float(1.5, "Min Volume Multiplier",    minval=1.0, maxval=10.0, step=0.5, group=grp_vol, tooltip="Volume must be this many times the average. 1.5x = optimal from 13.5-day backtest.")
vol_bonus    = input.float(5.0, "Bonus Volume Multiplier",  minval=2.0, maxval=10.0, step=0.5, group=grp_vol, tooltip="Above this adds a bonus score point.")

grp_dist    = "📏 Distance"
max_dist     = input.int(250, "Max Distance to Target ($)",  minval=150, maxval=500, step=25, group=grp_dist, tooltip="Only signal if the $250 strike is within this distance. $250 = backtest optimal.")

grp_htf     = "📐 Higher Timeframe"
use_htf      = input.bool(false, "Use 5-min momentum confirmation", group=grp_htf, tooltip="Off by default — the backtest winner didn't use this.")

// ─── TIME WINDOW ────────────────────────────────────────────────
min_of_hour  = minute(time)
in_window    = min_of_hour >= window_start and min_of_hour <= window_end

// ─── VELOCITY ───────────────────────────────────────────────────
// How much has price moved in the last N minutes?
// On 1-min chart, vel_bars=15 means 15 bars back.
price_change  = close - close[vel_bars]
velocity      = math.abs(price_change)
direction_up  = price_change > 0
direction_dn  = price_change < 0
vel_ok        = velocity >= vel_min
vel_extra     = velocity >= vel_bonus

// ─── VOLUME ─────────────────────────────────────────────────────
vol_sma       = ta.sma(volume, vol_len)
vol_ratio     = volume / vol_sma
vol_ok        = vol_ratio >= vol_min
vol_extra     = vol_ratio >= vol_bonus

// ─── DISTANCE TO TARGET ────────────────────────────────────────
// Calculate how far the nearest actionable $250 strike is.
// If heading UP: next $250 level above, at least $150 away.
// If heading DOWN: next $250 level below, at least $150 away.

nearest_above = math.ceil(close / 250) * 250
dist_above    = nearest_above - close
target_above  = dist_above >= 150 ? nearest_above : nearest_above + 250
final_dist_up = target_above - close

nearest_below = math.floor(close / 250) * 250
dist_below    = close - nearest_below
target_below  = dist_below >= 150 ? nearest_below : nearest_below - 250
final_dist_dn = close - target_below

dist_ok_up    = final_dist_up <= max_dist
dist_ok_dn    = final_dist_dn <= max_dist

// ─── HIGHER TIMEFRAME (optional) ───────────────────────────────
htf_roc       = request.security(syminfo.tickerid, "5", ta.roc(close, 3))
htf_bull      = use_htf ? htf_roc > 0.10 : true
htf_bear      = use_htf ? htf_roc < -0.10 : true

// ─── SCORING ────────────────────────────────────────────────────
// Base: 3/5 when all conditions met
// +1 for extra velocity, +1 for extra volume
bull_base     = vel_ok and vol_ok and dist_ok_up and direction_up
bear_base     = vel_ok and vol_ok and dist_ok_dn and direction_dn

bull_score    = (bull_base ? 3 : 0) + (vel_extra ? 1 : 0) + (vol_extra ? 1 : 0)
bear_score    = (bear_base ? 3 : 0) + (vel_extra ? 1 : 0) + (vol_extra ? 1 : 0)

// ─── SIGNALS ────────────────────────────────────────────────────
bull_raw = in_window and bull_base and htf_bull
bear_raw = in_window and bear_base and htf_bear

// ─── HOURLY COOLDOWN ────────────────────────────────────────────
var int last_signal_day_hour = -1
current_day_hour = dayofmonth(time) * 100 + hour(time)

bull_fire = bull_raw and current_day_hour != last_signal_day_hour
bear_fire = bear_raw and current_day_hour != last_signal_day_hour

if bull_fire or bear_fire
    last_signal_day_hour := current_day_hour

// ─── ALERTS ─────────────────────────────────────────────────────
if bull_fire
    alert('{"dir":"BULL","score":' + str.tostring(bull_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + '}', alert.freq_once_per_bar)

if bear_fire
    alert('{"dir":"BEAR","score":' + str.tostring(bear_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + '}', alert.freq_once_per_bar)

// ─── CHART VISUALS ──────────────────────────────────────────────
bgcolor(in_window ? color.new(color.yellow, 92) : na, title="Signal Window")

plotshape(bear_fire, "Bear", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(bull_fire, "Bull", shape.triangleup, location.belowbar, color.green, size=size.small)

if bull_fire
    lbl = "BULL ▲ [" + str.tostring(bull_score) + "/5]\n"
    lbl := lbl + "VEL: $" + str.tostring(velocity, "#") + "\n"
    lbl := lbl + "VOL: " + str.tostring(vol_ratio, "#.#") + "x\n"
    lbl := lbl + "DIST: $" + str.tostring(final_dist_up, "#") + " → $" + str.tostring(target_above, "#")
    label.new(bar_index, low, lbl, style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.normal)

if bear_fire
    lbl = "BEAR ▼ [" + str.tostring(bear_score) + "/5]\n"
    lbl := lbl + "VEL: $" + str.tostring(velocity, "#") + "\n"
    lbl := lbl + "VOL: " + str.tostring(vol_ratio, "#.#") + "x\n"
    lbl := lbl + "DIST: $" + str.tostring(final_dist_dn, "#") + " → $" + str.tostring(target_below, "#")
    label.new(bar_index, high, lbl, style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)

// ─── DASHBOARD ──────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "BTC Edge v4", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 60))
    table.cell(dash, 1, 0, "VEL+VOL", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 60))

    table.cell(dash, 0, 1, "Minute", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(min_of_hour) + (in_window ? " ✓ LIVE" : ""), text_color=in_window ? color.green : color.gray, text_size=size.small)

    table.cell(dash, 0, 2, "Velocity", text_color=color.white, text_size=size.small)
    vel_color = vel_extra ? color.green : vel_ok ? color.yellow : color.red
    vel_dir = price_change > 0 ? "▲" : "▼"
    table.cell(dash, 1, 2, vel_dir + " $" + str.tostring(velocity, "#") + " / " + str.tostring(vel_bars) + "min", text_color=vel_color, text_size=size.small)

    table.cell(dash, 0, 3, "Volume", text_color=color.white, text_size=size.small)
    vol_color = vol_extra ? color.green : vol_ok ? color.yellow : color.red
    table.cell(dash, 1, 3, str.tostring(vol_ratio, "#.#") + "x avg", text_color=vol_color, text_size=size.small)

    table.cell(dash, 0, 4, "Target ▲", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, "$" + str.tostring(target_above, "#") + " ($" + str.tostring(final_dist_up, "#") + ")", text_color=dist_ok_up ? color.green : color.red, text_size=size.small)

    table.cell(dash, 0, 5, "Target ▼", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, "$" + str.tostring(target_below, "#") + " ($" + str.tostring(final_dist_dn, "#") + ")", text_color=dist_ok_dn ? color.green : color.red, text_size=size.small)

    table.cell(dash, 0, 6, "Status", text_color=color.white, text_size=size.small)
    ready = in_window and vel_ok and vol_ok and (dist_ok_up or dist_ok_dn)
    table.cell(dash, 1, 6, ready ? "🟢 READY" : "⏳ WAITING", text_color=ready ? color.green : color.gray, text_size=size.small)
