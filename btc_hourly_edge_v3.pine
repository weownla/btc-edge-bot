//@version=5
indicator("BTC Hourly Edge v3", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
// BTC Hourly Edge Detector v3 — "The Squeeze"
// ═══════════════════════════════════════════════════════════════════
// v2.1 PROBLEM: 7 momentum-confirmation factors meant by the time
// 6/7 aligned, the move was often ALREADY OVER. You were buying
// at the tail end of momentum, not the start.
//
// v3 FIX: Detect COMPRESSION before the breakout, not after.
// When BTC coils tight then snaps with volume, the move is
// just starting — Kalshi contracts are still dirt cheap.
//
// 5 SCORING FACTORS:
// 1. Squeeze Release  — Bollinger Bands break out of Keltner Channels
// 2. VWAP Clear       — Price decisively above/below fair value
// 3. Volume Ignition  — 2.5x+ volume spike confirms real participation
// 4. Range Break      — Breaking the 15-min high/low (clean air)
// 5. ROC Acceleration — Momentum building, not fading
// ═══════════════════════════════════════════════════════════════════

// ─── INPUTS ─────────────────────────────────────────────────────
grp_time    = "⏰ Time Window"
window_start = input.int(50, "Signal Window Start (minute)", minval=45, maxval=57, group=grp_time)
window_end   = input.int(57, "Signal Window End (minute)",   minval=50, maxval=59, group=grp_time)

grp_squeeze = "🔧 Squeeze Detection"
bb_len       = input.int(20,   "Bollinger Band Length",     minval=10, maxval=50, group=grp_squeeze)
bb_mult      = input.float(2.0, "BB Std Dev Multiplier",    minval=1.0, maxval=3.0, step=0.1, group=grp_squeeze)
kc_len       = input.int(20,   "Keltner Channel Length",    minval=10, maxval=50, group=grp_squeeze)
kc_mult      = input.float(1.5, "KC ATR Multiplier",        minval=1.0, maxval=3.0, step=0.1, group=grp_squeeze)
sq_lookback  = input.int(5,    "Squeeze lookback (bars)",   minval=2,  maxval=15, group=grp_squeeze, tooltip="How recently must the squeeze have been active? Lower = stricter.")

grp_vwap    = "📊 VWAP"
vwap_disp    = input.float(0.05, "VWAP Displacement %",     minval=0.01, maxval=0.5, step=0.01, group=grp_vwap, tooltip="How far above/below VWAP to count as 'decisively clear'.")

grp_vol     = "🔊 Volume"
vol_len      = input.int(20,  "Volume SMA Length",          minval=10, maxval=50, group=grp_vol)
vol_mult     = input.float(2.5, "Volume Spike Multiplier",  minval=1.5, maxval=5.0, step=0.1, group=grp_vol)

grp_range   = "📏 Range Break"
range_len    = input.int(15,  "Range Lookback (bars)",      minval=5,  maxval=30, group=grp_range, tooltip="Breaking the high/low of this many 1-min bars = clean breakout.")

grp_mom     = "⚡ Momentum"
roc_len      = input.int(5,   "ROC Length",                 minval=2,  maxval=10, group=grp_mom)
roc_thresh   = input.float(0.15, "ROC Threshold (%)",       minval=0.05, maxval=1.0, step=0.05, group=grp_mom)

grp_htf     = "📐 Higher Timeframe"
use_htf      = input.bool(true, "Use 5-min momentum confirmation", group=grp_htf)

grp_filter  = "🎯 Signal Quality"
min_score    = input.int(3, "Min Confluence Score (out of 5)", minval=2, maxval=5, group=grp_filter)

// ─── TIME WINDOW ────────────────────────────────────────────────
min_of_hour  = minute(time)
in_window    = min_of_hour >= window_start and min_of_hour <= window_end

// ═══════════════════════════════════════════════════════════════════
// FACTOR 1: SQUEEZE RELEASE (TTM Squeeze)
// ═══════════════════════════════════════════════════════════════════
// When Bollinger Bands pinch inside Keltner Channels = compression.
// When they break back out = the squeeze has fired. Spring released.

// Bollinger Bands
bb_basis     = ta.sma(close, bb_len)
bb_dev       = ta.stdev(close, bb_len) * bb_mult
bb_upper     = bb_basis + bb_dev
bb_lower     = bb_basis - bb_dev

// Keltner Channels
kc_basis     = ta.sma(close, kc_len)
kc_atr       = ta.atr(kc_len) * kc_mult
kc_upper     = kc_basis + kc_atr
kc_lower     = kc_basis - kc_atr

// Squeeze state: BB inside KC = squeeze is ON (coiling)
squeeze_on   = bb_lower > kc_lower and bb_upper < kc_upper
squeeze_off  = not squeeze_on

// Squeeze FIRED = was on recently, now off (spring just released)
was_squeezed = false
for i = 1 to sq_lookback
    if squeeze_on[i]
        was_squeezed := true
squeeze_fired = squeeze_off and was_squeezed

// ═══════════════════════════════════════════════════════════════════
// FACTOR 2: VWAP CLEAR
// ═══════════════════════════════════════════════════════════════════
// Price decisively above/below the volume-weighted fair value.
// VWAP is where institutional algos anchor — clearing it = real move.

vwap_val     = ta.vwap(hlc3)
vwap_bull    = (close - vwap_val) / vwap_val * 100 > vwap_disp
vwap_bear    = (vwap_val - close) / vwap_val * 100 > vwap_disp

// ═══════════════════════════════════════════════════════════════════
// FACTOR 3: VOLUME IGNITION
// ═══════════════════════════════════════════════════════════════════
// A breakout without volume is a fakeout.
// Need 2.5x+ normal volume to confirm real participation.

vol_sma      = ta.sma(volume, vol_len)
vol_ignition = volume > vol_sma * vol_mult

// ═══════════════════════════════════════════════════════════════════
// FACTOR 4: RANGE BREAK
// ═══════════════════════════════════════════════════════════════════
// Price breaks the high/low of the last 15 minutes = clean air.
// No more chop — it's broken free from the range.

range_high   = ta.highest(high, range_len)
range_low    = ta.lowest(low, range_len)
// Breaking above the high of the last 15 bars (excluding current)
break_high   = close > ta.highest(high[1], range_len)
break_low    = close < ta.lowest(low[1], range_len)

// ═══════════════════════════════════════════════════════════════════
// FACTOR 5: ROC ACCELERATION
// ═══════════════════════════════════════════════════════════════════
// Momentum is building, not fading. Kept from v2.1 — still the
// best single momentum indicator for this timeframe.

roc_val      = ta.roc(close, roc_len)
roc_prev     = ta.roc(close[1], roc_len)
roc_bull     = roc_val > roc_thresh and roc_val > roc_prev
roc_bear     = roc_val < -roc_thresh and roc_val < roc_prev

// ─── HIGHER TIMEFRAME (5-min) ──────────────────────────────────
htf_roc      = request.security(syminfo.tickerid, "5", ta.roc(close, 3))
htf_bull     = use_htf ? htf_roc > 0.10 : true
htf_bear     = use_htf ? htf_roc < -0.10 : true

// ═══════════════════════════════════════════════════════════════════
// SCORING
// ═══════════════════════════════════════════════════════════════════

bull_score = 0
bull_score := bull_score + (squeeze_fired ? 1 : 0)   // Spring released
bull_score := bull_score + (vwap_bull     ? 1 : 0)   // Above fair value
bull_score := bull_score + (vol_ignition  ? 1 : 0)   // Real volume
bull_score := bull_score + (break_high    ? 1 : 0)   // Clean air above
bull_score := bull_score + (roc_bull      ? 1 : 0)   // Accelerating up

bear_score = 0
bear_score := bear_score + (squeeze_fired ? 1 : 0)
bear_score := bear_score + (vwap_bear     ? 1 : 0)
bear_score := bear_score + (vol_ignition  ? 1 : 0)
bear_score := bear_score + (break_low     ? 1 : 0)
bear_score := bear_score + (roc_bear      ? 1 : 0)

// ─── SIGNALS ────────────────────────────────────────────────────
bull_raw = in_window and bull_score >= min_score and htf_bull
bear_raw = in_window and bear_score >= min_score and htf_bear

// ─── HOURLY COOLDOWN ────────────────────────────────────────────
var int last_signal_day_hour = -1
current_day_hour = dayofmonth(time) * 100 + hour(time)

bull_fire = bull_raw and current_day_hour != last_signal_day_hour
bear_fire = bear_raw and current_day_hour != last_signal_day_hour

if bull_fire or bear_fire
    last_signal_day_hour := current_day_hour

// ─── ALERTS (JSON → webhook → bot → Telegram) ──────────────────
if bear_fire
    alert('{"dir":"BEAR","score":' + str.tostring(bear_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + ',"sq":' + (squeeze_fired ? '1' : '0') + ',"vw":' + (vwap_bear ? '1' : '0') + ',"vi":' + (vol_ignition ? '1' : '0') + ',"rb":' + (break_low ? '1' : '0') + ',"rc":' + (roc_bear ? '1' : '0') + '}', alert.freq_once_per_bar)

if bull_fire
    alert('{"dir":"BULL","score":' + str.tostring(bull_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + ',"sq":' + (squeeze_fired ? '1' : '0') + ',"vw":' + (vwap_bull ? '1' : '0') + ',"vi":' + (vol_ignition ? '1' : '0') + ',"rb":' + (break_high ? '1' : '0') + ',"rc":' + (roc_bull ? '1' : '0') + '}', alert.freq_once_per_bar)

// ─── CHART VISUALS ──────────────────────────────────────────────

// Signal window background
bgcolor(in_window ? color.new(color.yellow, 92) : na, title="Signal Window")

// Squeeze state: red = coiling, green = released
bgcolor(squeeze_on ? color.new(color.red, 94) : na, title="Squeeze Active")

// Signal markers
plotshape(bear_fire, "Bear", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(bull_fire, "Bull", shape.triangleup,   location.belowbar, color.green, size=size.small)

// Signal labels
if bear_fire
    lbl = "BEAR ▼ [" + str.tostring(bear_score) + "/5]\n"
    lbl := lbl + "SQ:" + (squeeze_fired ? "✓" : "✗") + " VW:" + (vwap_bear ? "✓" : "✗") + "\n"
    lbl := lbl + "VI:" + (vol_ignition ? "✓" : "✗") + " RB:" + (break_low ? "✓" : "✗") + "\n"
    lbl := lbl + "RC:" + (roc_bear ? "✓" : "✗")
    label.new(bar_index, high, lbl, style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)

if bull_fire
    lbl = "BULL ▲ [" + str.tostring(bull_score) + "/5]\n"
    lbl := lbl + "SQ:" + (squeeze_fired ? "✓" : "✗") + " VW:" + (vwap_bull ? "✓" : "✗") + "\n"
    lbl := lbl + "VI:" + (vol_ignition ? "✓" : "✗") + " RB:" + (break_high ? "✓" : "✗") + "\n"
    lbl := lbl + "RC:" + (roc_bull ? "✓" : "✗")
    label.new(bar_index, low, lbl, style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.normal)

// VWAP line
plot(vwap_val, "VWAP", color.new(color.orange, 30), linewidth=2)

// Bollinger Bands (thin, for reference)
plot(bb_upper, "BB Upper", color.new(color.blue, 70), linewidth=1)
plot(bb_lower, "BB Lower", color.new(color.blue, 70), linewidth=1)

// Keltner Channels (dotted)
plot(kc_upper, "KC Upper", color.new(color.purple, 70), linewidth=1, style=plot.style_cross)
plot(kc_lower, "KC Lower", color.new(color.purple, 70), linewidth=1, style=plot.style_cross)

// 15-bar range
plot(ta.highest(high[1], range_len), "Range High", color.new(color.green, 80), linewidth=1, style=plot.style_stepline)
plot(ta.lowest(low[1], range_len),   "Range Low",  color.new(color.red, 80),   linewidth=1, style=plot.style_stepline)

// ─── DASHBOARD ──────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "BTC Edge v3",    text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 60))
    table.cell(dash, 1, 0, "THE SQUEEZE",     text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 60))
    table.cell(dash, 0, 1, "Minute",          text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(min_of_hour) + (in_window ? " ✓ LIVE" : ""), text_color=in_window ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 2, "Squeeze",         text_color=color.white,  text_size=size.small)
    sq_status = squeeze_on ? "COILING 🔴" : squeeze_fired ? "FIRED 🟢" : "OFF"
    table.cell(dash, 1, 2, sq_status, text_color=squeeze_fired ? color.green : squeeze_on ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 3, "VWAP Disp",       text_color=color.white,  text_size=size.small)
    vwap_d = (close - vwap_val) / vwap_val * 100
    table.cell(dash, 1, 3, str.tostring(vwap_d, "#.###") + "%", text_color=(vwap_bull or vwap_bear) ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 4, "Vol Ratio",       text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(volume / vol_sma, "#.##") + "x", text_color=vol_ignition ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 5, "Range",           text_color=color.white,  text_size=size.small)
    range_status = break_high ? "BREAK ▲" : break_low ? "BREAK ▼" : "INSIDE"
    table.cell(dash, 1, 5, range_status, text_color=(break_high or break_low) ? color.green : color.gray, text_size=size.small)
    table.cell(dash, 0, 6, "ROC",             text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(roc_val, "#.###") + "%", text_color=(roc_bull or roc_bear) ? color.green : color.gray, text_size=size.small)
    nearest_strike = math.round(close / 250) * 250
    table.cell(dash, 0, 7, "Nearest $250",    text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 7, "$" + str.tostring(nearest_strike, "#"), text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 8, "Dist to Strike",  text_color=color.white,  text_size=size.small)
    table.cell(dash, 1, 8, "$" + str.tostring(math.abs(close - nearest_strike), "#"), text_color=color.white, text_size=size.small)
