//@version=5
indicator("BTC Trend Rider v6", overlay=true, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════
// BTC Trend Rider v6 — Volatile Regime + Trend Alignment
// ═══════════════════════════════════════════════════════════════════
// Core insight: on volatile trending days, BTC moves $1,000+ in one
// direction. Kalshi prices "10% chance" contracts that are really
// 40-50% when you account for trend continuation.
//
// Three conditions:
//   1. VOLATILE REGIME: ATR(4) ≥ 1.5× ATR(48) — big candles
//   2. MULTI-HOUR TREND: 2h move ≥ $200 AND 4h move ≥ $300 same dir
//   3. LATE WINDOW: :50-:57 only — cheapest contracts, 8-12x payouts
//
// Settle-validated backtest (20 days):
//   Trend+vel: 8/20 wins (40%), +$2,215 at $10/bet
// ═══════════════════════════════════════════════════════════════════

// ─── INPUTS ─────────────────────────────────────────────────────
grp_regime  = "🌡️ Volatility Regime"
atr_fast     = input.int(4, "ATR Fast (bars)",     minval=2, maxval=10, group=grp_regime)
atr_slow     = input.int(48, "ATR Slow (bars)",    minval=20, maxval=96, group=grp_regime)
atr_thresh   = input.float(1.5, "Min ATR Ratio",   minval=1.0, maxval=3.0, step=0.1, group=grp_regime, tooltip="1.5 = candles are 50% bigger than normal. Today's crash was 2.0+")

grp_trend   = "📈 Trend Detection"
trend_2h_min = input.float(200, "Min 2h Move ($)",  minval=50, maxval=500, step=50, group=grp_trend)
trend_4h_min = input.float(300, "Min 4h Move ($)",  minval=100, maxval=1000, step=50, group=grp_trend)

grp_time    = "⏰ Entry Window"
window_start = input.int(50, "Window Start (minute)", minval=40, maxval=57, group=grp_time)
window_end   = input.int(57, "Window End (minute)",   minval=45, maxval=59, group=grp_time)

grp_vel     = "🚀 Velocity (optional boost)"
vel_bars     = input.int(15, "Lookback (bars)",      minval=5, maxval=30, group=grp_vel)
vel_min      = input.float(75, "Min Velocity ($)",   minval=0, maxval=500, step=25, group=grp_vel, tooltip="0 = disabled. 75 = require some recent movement too.")
vol_min      = input.float(1.5, "Min Volume Mult",   minval=0.0, maxval=5.0, step=0.5, group=grp_vel, tooltip="0 = disabled")

// ─── VOLATILITY REGIME ──────────────────────────────────────────
atr_f = ta.atr(atr_fast)
atr_s = ta.atr(atr_slow)
atr_ratio = atr_f / atr_s
regime_hot = atr_ratio >= atr_thresh

// ─── MULTI-HOUR TREND ───────────────────────────────────────────
// On 1-min chart: 2h = 120 bars, 4h = 240 bars
bars_2h = 120
bars_4h = 240
trend_2h = close - close[bars_2h]
trend_4h = close - close[bars_4h]

strong_up   = trend_2h >= trend_2h_min and trend_4h >= trend_4h_min
strong_down = trend_2h <= -trend_2h_min and trend_4h <= -trend_4h_min
has_trend   = strong_up or strong_down

// ─── VELOCITY (optional) ────────────────────────────────────────
velocity = math.abs(close - close[vel_bars])
vol_sma  = ta.sma(volume, 20)
vol_ratio = volume / vol_sma
vel_ok = vel_min == 0 ? true : velocity >= vel_min
vol_ok = vol_min == 0 ? true : vol_ratio >= vol_min

// ─── TIME WINDOW ────────────────────────────────────────────────
min_of_hour = minute(time)
in_window = min_of_hour >= window_start and min_of_hour <= window_end

// ─── TARGET CALCULATION ─────────────────────────────────────────
nearest_above = math.ceil(close / 250) * 250
dist_above    = nearest_above - close
target_above  = dist_above >= 150 ? nearest_above : nearest_above + 250
final_dist_up = target_above - close

nearest_below = math.floor(close / 250) * 250
dist_below    = close - nearest_below
target_below  = dist_below >= 150 ? nearest_below : nearest_below - 250
final_dist_dn = close - target_below

// ─── SIGNALS ────────────────────────────────────────────────────
bull_raw = in_window and regime_hot and strong_up and vel_ok and vol_ok and final_dist_up <= 250
bear_raw = in_window and regime_hot and strong_down and vel_ok and vol_ok and final_dist_dn <= 250

// ─── HOURLY COOLDOWN ────────────────────────────────────────────
var int last_signal_day_hour = -1
current_day_hour = dayofmonth(time) * 100 + hour(time)
bull_fire = bull_raw and current_day_hour != last_signal_day_hour
bear_fire = bear_raw and current_day_hour != last_signal_day_hour
if bull_fire or bear_fire
    last_signal_day_hour := current_day_hour

// ─── SCORING ────────────────────────────────────────────────────
score_regime = atr_ratio >= 2.0 ? 2 : atr_ratio >= 1.5 ? 1 : 0
score_trend  = math.abs(trend_4h) >= 500 ? 2 : math.abs(trend_4h) >= 300 ? 1 : 0
score_vel    = velocity >= 200 ? 1 : 0
total_score  = score_regime + score_trend + score_vel

// ─── ALERTS ─────────────────────────────────────────────────────
if bull_fire
    alert('{"dir":"BULL","score":' + str.tostring(total_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + ',"atr":' + str.tostring(atr_ratio, "#.##") + ',"t2h":' + str.tostring(trend_2h, "#") + ',"t4h":' + str.tostring(trend_4h, "#") + '}', alert.freq_once_per_bar)

if bear_fire
    alert('{"dir":"BEAR","score":' + str.tostring(total_score) + ',"price":' + str.tostring(close, "#.##") + ',"min":' + str.tostring(min_of_hour) + ',"atr":' + str.tostring(atr_ratio, "#.##") + ',"t2h":' + str.tostring(trend_2h, "#") + ',"t4h":' + str.tostring(trend_4h, "#") + '}', alert.freq_once_per_bar)

// ─── VISUALS ────────────────────────────────────────────────────
bgcolor(in_window and regime_hot and has_trend ? color.new(color.orange, 85) : in_window ? color.new(color.yellow, 92) : na, title="Window")

plotshape(bear_fire, "Bear", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(bull_fire, "Bull", shape.triangleup, location.belowbar, color.green, size=size.small)

if bull_fire
    lbl = "TREND BULL ▲ [" + str.tostring(total_score) + "/5]\n"
    lbl := lbl + "ATR: " + str.tostring(atr_ratio, "#.#") + "x | "
    lbl := lbl + "4h: $" + str.tostring(trend_4h, "#") + "\n"
    lbl := lbl + "DIST: $" + str.tostring(final_dist_up, "#") + " → $" + str.tostring(target_above, "#")
    label.new(bar_index, low, lbl, style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.normal)

if bear_fire
    lbl = "TREND BEAR ▼ [" + str.tostring(total_score) + "/5]\n"
    lbl := lbl + "ATR: " + str.tostring(atr_ratio, "#.#") + "x | "
    lbl := lbl + "4h: $" + str.tostring(trend_4h, "#") + "\n"
    lbl := lbl + "DIST: $" + str.tostring(final_dist_dn, "#") + " → $" + str.tostring(target_below, "#")
    label.new(bar_index, high, lbl, style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)

// ─── DASHBOARD ──────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "Trend Rider v6", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black, 60))
    table.cell(dash, 1, 0, regime_hot and has_trend ? "🔥 HOT" : regime_hot ? "⚡ VOLATILE" : "❄️ QUIET", text_color=regime_hot and has_trend ? color.red : color.gray, text_size=size.small, bgcolor=color.new(color.black, 60))

    table.cell(dash, 0, 1, "Minute", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(min_of_hour) + (in_window ? " ✓ LIVE" : ""), text_color=in_window ? color.green : color.gray, text_size=size.small)

    table.cell(dash, 0, 2, "ATR Ratio", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(atr_ratio, "#.##") + "x", text_color=regime_hot ? color.green : color.red, text_size=size.small)

    table.cell(dash, 0, 3, "2h Trend", text_color=color.white, text_size=size.small)
    t2_color = strong_up ? color.green : strong_down ? color.red : color.gray
    table.cell(dash, 1, 3, "$" + str.tostring(trend_2h, "#"), text_color=t2_color, text_size=size.small)

    table.cell(dash, 0, 4, "4h Trend", text_color=color.white, text_size=size.small)
    t4_color = math.abs(trend_4h) >= trend_4h_min ? (trend_4h > 0 ? color.green : color.red) : color.gray
    table.cell(dash, 1, 4, "$" + str.tostring(trend_4h, "#"), text_color=t4_color, text_size=size.small)

    table.cell(dash, 0, 5, "Velocity", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, "$" + str.tostring(velocity, "#") + " / " + str.tostring(vel_bars) + "min", text_color=vel_ok ? color.green : color.gray, text_size=size.small)

    table.cell(dash, 0, 6, "Target ▲", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, "$" + str.tostring(target_above, "#") + " ($" + str.tostring(final_dist_up, "#") + ")", text_color=color.green, text_size=size.small)

    table.cell(dash, 0, 7, "Target ▼", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, "$" + str.tostring(target_below, "#") + " ($" + str.tostring(final_dist_dn, "#") + ")", text_color=color.red, text_size=size.small)
